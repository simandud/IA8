# Base de datos MongoDB
MONGODB_URI=mongodb://localhost:27017/marketing-campaigns

# API de Anthropic Claude
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# NextAuth
NEXTAUTH_URL=http://localhost:3000
